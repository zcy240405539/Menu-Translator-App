{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "distribution": "store",
      "autoIncrement": true
    },
    "production-ios": {
      "extends": "production",
      "env": {
        "APP_VERSION": "1.2"
      }
    },
    "production-android": {
      "extends": "production",
      "autoIncrement": false,
      "credentialsSource": "local",
      "env": {
        "APP_VERSION": "2.6"
      }
    },
    "android-apk": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VERSION": "2.6"
      }
    }
  },
  "submit": {
    "production": {},
    "production-ios": {
      "ios": {
        "ascAppId": "6807476485"
      }
    }
  }
}